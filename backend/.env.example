# # ---------------------------------------------------------------
# # Copy this file to .env and fill in real values. Never commit .env.
# # ---------------------------------------------------------------

# # PostgreSQL connection string
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/restaurant_platform?schema=public"

# # JWT
# JWT_SECRET="replace-with-a-long-random-string"
# JWT_EXPIRES_IN="7d"

# # Server
# PORT=4000
# NODE_ENV=development
# FRONTEND_URL="http://localhost:5173"

# # Image storage (Cloudinary) - required for product/gallery image uploads.
# # Once set, the admin panel's "Add Image" flows switch from URL-paste to
# # real drag-and-drop file upload automatically (GET /api/uploads/status).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # Online payments (Razorpay) - required only if enabling UPI/card payments.
# # Once set, checkout automatically offers Razorpay checkout for UPI/Card and
# # payments are verified server-side via HMAC signature before being marked paid.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# # WhatsApp - the restaurant's WhatsApp number used for click-to-chat links
# # and order-notification messages. Format: country code + number, no spaces.
# WHATSAPP_NUMBER=

# # Optional: combined single-server deployment. When true, this backend also
# # serves the built frontend (see README section 5b) so the whole app runs as
# # one service on one URL instead of two separate deployments.
# SERVE_FRONTEND=false
# FRONTEND_DIST_PATH=../frontend-dist

# # Optional: seed script demo passwords (defaults to ChangeMe123! if unset)
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CASHIER_PASSWORD=
# ---------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/restaurant_platform?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Image storage (Cloudinary) - required for product/gallery image uploads.
# Once set, the admin panel's "Add Image" flows switch from URL-paste to
# real drag-and-drop file upload automatically (GET /api/uploads/status).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Online payments (Razorpay) - required only if enabling UPI/card payments.
# Once set, checkout automatically offers Razorpay checkout for UPI/Card and
# payments are verified server-side via HMAC signature before being marked paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp - the restaurant's WhatsApp number used for click-to-chat links
# and order-notification messages. Format: country code + number, no spaces.
WHATSAPP_NUMBER=

# Optional: combined single-server deployment. When true, this backend also
# serves the built frontend (see README section 5b) so the whole app runs as
# one service on one URL instead of two separate deployments.
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../frontend-dist

# Optional: seed script demo passwords (defaults to ChangeMe123! if unset).
# IMPORTANT: leave these commented out (not `KEY=` with nothing after it) —
# an uncommented empty value is treated as "explicitly set to blank" and will
# NOT fall back to the default, which locks you out with a blank password.
# SEED_ADMIN_PASSWORD=YourOwnPasswordHere
# SEED_MANAGER_PASSWORD=YourOwnPasswordHere
# SEED_CASHIER_PASSWORD=YourOwnPasswordHere